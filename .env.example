# Copy to .env and adjust. Used by docker compose.

# Model the agent, user simulator and judge use (pulled automatically if missing)
CRUCIBLE_MODEL=qwen2.5:7b

# Reuse models you already downloaded with a local Ollama instead of pulling again.
# Windows: C:/Users/<you>/.ollama/models   macOS/Linux: ~/.ollama/models
# Leave unset to use a Docker volume.
# OLLAMA_MODELS_DIR=C:/Users/you/.ollama/models

OLLAMA_VERSION=0.17.1

POSTGRES_USER=crucible
POSTGRES_PASSWORD=crucible
POSTGRES_DB=crucible
