# Copy to .env and adjust. Used by docker compose.

# Project the dashboard serves: support-agent or coding-agent
CRUCIBLE_PROJECT=support-agent

# Model the agent, user simulator and judge use (pulled automatically if missing)
CRUCIBLE_MODEL=qwen2.5:7b

# Reuse models you already downloaded with a local Ollama instead of pulling again.
# Windows: C:/Users/<you>/.ollama/models   macOS/Linux: ~/.ollama/models
# Leave unset to use a Docker volume.
# OLLAMA_MODELS_DIR=C:/Users/you/.ollama/models

OLLAMA_VERSION=0.17.1

POSTGRES_USER=crucible
POSTGRES_PASSWORD=crucible
POSTGRES_DB=crucible

# Protect the dashboard and API with tokens (leave empty for open access on localhost).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# CRUCIBLE_API_TOKEN=       # full access: start runs and audits
# CRUCIBLE_VIEWER_TOKEN=    # optional: read-only

# Postgres server for `postgres` fixtures (defaults to the stack's own db service)
# CRUCIBLE_POSTGRES_URL=postgresql://user:pass@host:5432/postgres

# Import codebase (dashboard → Import codebase): the folder holding the repositories to import, mounted at /import.
# Approved tests are written into each repository's agent-tests/ folder.
# CRUCIBLE_IMPORT_DIR=C:/Users/you/code
# Optional: let Claude or OpenAI write the import's descriptions (much faster than a local model on a CPU).
# The import's Options then list the models this key can use; you can also paste a key there for one import.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
